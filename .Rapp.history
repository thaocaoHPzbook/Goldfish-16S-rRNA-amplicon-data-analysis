library(readr)#
library(dplyr)#
library(tidyr)#
#
# Đọc dữ liệu#
metadata <- read_tsv("/Users/truonganhtu/Downloads/metadata.tsv")#
feature_table <- read_tsv("/Users/truonganhtu/Downloads/feature-table.tsv")#
#
# Kiểm tra dữ liệu#
head(metadata)#
head(feature_table)
# Chuyển feature_table từ wide sang long#
feature_long <- feature_table %>%#
  pivot_longer(cols = -OTU_ID, names_to = "sample-id", values_to = "abundance") %>%#
  mutate(`sample-id` = as.numeric(`sample-id`))  # Chuyển về dạng số để join với metadata#
#
# Gộp dữ liệu feature_table và metadata theo sample-id#
merged_data <- feature_long %>%#
  inner_join(metadata, by = "sample-id")#
#
# Kiểm tra dữ liệu sau khi merge#
head(merged_data)
# Chọn OTU cần kiểm tra (ví dụ: OTU_1)#
otu_of_interest <- "OTU_1"#
#
# Lọc dữ liệu cho OTU này#
df <- merged_data %>%#
  filter(OTU_ID == otu_of_interest) %>%#
  select(abundance, `Final weight`)  # Có thể thay Final weight bằng các chỉ số khác#
#
# Tính Spearman correlation#
cor.test(df$abundance, df$`Final weight`, method = "spearman")
# Chọn OTU cần kiểm tra (ví dụ: OTU_1)#
otu_of_interest <- "OTU_1"#
#
# Lọc dữ liệu cho OTU này#
df <- merged_data %>%#
  filter(OTU_ID == otu_of_interest) %>%#
  select(abundance, `Percentage weight gain`)  # Có thể thay Final weight bằng các chỉ số khác#
#
# Tính Spearman correlation#
cor.test(df$abundance, df$`Final weight`, method = "spearman")
# Tạo danh sách các OTU#
otu_list <- unique(merged_data$OTU_ID)#
#
# Tính tương quan Spearman giữa từng OTU và Final weight#
cor_results <- data.frame(OTU_ID = character(), Correlation = numeric(), P_value = numeric())#
#
for (otu in otu_list) {#
  df <- merged_data %>%#
    filter(OTU_ID == otu) %>%#
    select(abundance, `Final weight`)#
  if (nrow(df) > 2) {  # Cần ít nhất 3 điểm để tính tương quan#
    cor_test <- cor.test(df$abundance, df$`Final weight`, method = "spearman")#
    cor_results <- rbind(cor_results, data.frame(OTU_ID = otu, Correlation = cor_test$estimate, P_value = cor_test$p.value))#
  }#
}#
#
# Xem kết quả#
cor_results <- cor_results %>%#
  arrange(P_value)  # Sắp xếp theo p-value để thấy OTU nào có ý nghĩa thống kê nhất#
#
print(cor_results)
significant_otus <- cor_results %>%#
  filter(P_value < 0.05) %>%#
  arrange(desc(abs(Correlation)))  # Sắp xếp theo độ mạnh của tương quan#
#
print(significant_otus)
library(ggplot2)#
#
# Chọn một OTU có tương quan mạnh#
otu_top <- significant_otus$OTU_ID[1]#
#
# Lọc dữ liệu#
df_plot <- merged_data %>%#
  filter(OTU_ID == otu_top) %>%#
  select(abundance, `Final weight`)#
#
# Vẽ scatter plot#
ggplot(df_plot, aes(x = abundance, y = `Final weight`)) +#
  geom_point() +#
  geom_smooth(method = "lm", color = "blue") +#
  labs(title = paste("Correlation between", otu_top, "and Final weight"),#
       x = "OTU Abundance", y = "Final Weight") +#
  theme_minimal()
# Cài đặt các thư viện#
library(ggplot2)#
library(ggpubr)#
#
# Lấy OTU có tương quan dương mạnh nhất#
otu_positive <- significant_otus$OTU_ID[1] #
#
# Lấy OTU có tương quan âm mạnh nhất#
otu_negative <- significant_otus$OTU_ID[nrow(significant_otus)] #
#
# Hàm tạo biểu đồ#
plot_correlation <- function(otu_id, data, variable) {#
  df <- data %>%#
    filter(OTU_ID == otu_id) %>%#
    select(abundance, !!sym(variable))#
  # Tính tương quan#
  cor_test <- cor.test(df$abundance, df[[variable]], method = "spearman")#
  # Vẽ biểu đồ#
  ggplot(df, aes(x = abundance, y = .data[[variable]])) +#
    geom_point(color = "#0072B2", size = 3, alpha = 0.7) +  # Màu xanh chuyên nghiệp#
    geom_smooth(method = "lm", color = "#D55E00", se = FALSE) +  # Đường hồi quy màu cam#
    labs(title = paste("Correlation:", otu_id),#
         x = "OTU Abundance",#
         y = variable) +#
    annotate("text", x = max(df$abundance) * 0.8, #
             y = max(df[[variable]]) * 0.9, #
             label = paste0("r = ", round(cor_test$estimate, 2), #
                            "\np = ", signif(cor_test$p.value, 3)),#
             size = 5, color = "black") +#
    theme_minimal() +#
    theme(plot.title = element_text(size = 14, face = "bold"),#
          axis.title = element_text(size = 12))#
}#
#
# Vẽ hai biểu đồ#
p1 <- plot_correlation(otu_positive, merged_data, "Final weight")#
p2 <- plot_correlation(otu_negative, merged_data, "Final weight")#
#
# Gộp hai biểu đồ vào một hình#
ggarrange(p1, p2, ncol = 2, nrow = 1)
# Cài đặt thư viện#
library(ggplot2)#
library(ggpubr)#
library(dplyr)#
#
# Hàm tạo biểu đồ với kiểm tra lỗi#
plot_correlation <- function(otu_id, data, variable) {#
  df <- data %>%#
    filter(OTU_ID == otu_id) %>%#
    select(abundance, !!sym(variable)) #
  # Kiểm tra nếu dữ liệu rỗng#
  if (nrow(df) == 0) {#
    message(paste("⚠️ Không tìm thấy dữ liệu cho OTU:", otu_id))#
    return(NULL)#
  }#
  # Tính tương quan, dùng exact = FALSE để tránh lỗi ties#
  cor_test <- cor.test(df$abundance, df[[variable]], method = "spearman", exact = FALSE)#
  # Vẽ biểu đồ#
  ggplot(df, aes(x = abundance, y = .data[[variable]])) +#
    geom_point(color = "#0072B2", size = 3, alpha = 0.7) +  # Màu xanh chuyên nghiệp#
    geom_smooth(method = "lm", color = "#D55E00", se = FALSE) +  # Đường hồi quy màu cam#
    labs(title = paste("Correlation:", otu_id),#
         x = "OTU Abundance",#
         y = variable) +#
    annotate("text", x = max(df$abundance, na.rm = TRUE) * 0.8, #
             y = max(df[[variable]], na.rm = TRUE) * 0.9, #
             label = paste0("r = ", round(cor_test$estimate, 2), #
                            "\np = ", signif(cor_test$p.value, 3)),#
             size = 5, color = "black") +#
    theme_minimal() +#
    theme(plot.title = element_text(size = 14, face = "bold"),#
          axis.title = element_text(size = 12))#
}#
#
# Lấy OTU có tương quan dương mạnh nhất#
otu_positive <- significant_otus$OTU_ID[1] #
otu_negative <- significant_otus$OTU_ID[nrow(significant_otus)] #
#
# Vẽ hai biểu đồ, kiểm tra lỗi NULL#
p1 <- plot_correlation(otu_positive, merged_data, "Final weight")#
p2 <- plot_correlation(otu_negative, merged_data, "Final weight")#
#
# Gộp biểu đồ (chỉ gộp nếu cả hai biểu đồ tồn tại)#
if (!is.null(p1) & !is.null(p2)) {#
  ggarrange(p1, p2, ncol = 2, nrow = 1)#
} else {#
  message("⚠️ Không đủ dữ liệu để vẽ cả hai biểu đồ!")#
}
