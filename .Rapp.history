# Load thư viện#
library(ggplot2)#
library(patchwork)#
#
# Chuyển Treatment thành dạng factor để vẽ#
metadata$Treatment_factor <- as.factor(metadata$Treatment_binary)#
#
# Danh sách chỉ số sinh trưởng#
growth_metrics <- c("Final weight", "Specific growth rate", "Feed conversion ratio", #
                    "Weight gain", "Survival rate", "Percentage weight gain", "Daily weight gain")#
#
# Dataframe lưu kết quả p-value#
cor_results <- data.frame(Metric = character(), Spearman_rho = numeric(), p_value = numeric())#
#
# Tạo danh sách biểu đồ#
plot_list <- lapply(growth_metrics, function(metric) {#
  # Tính Spearman correlation#
  cor_test <- cor.test(metadata$Treatment_binary, metadata[[metric]], method = "spearman")#
  # Lưu kết quả vào dataframe#
  cor_results <<- rbind(cor_results, #
                        data.frame(Metric = metric, #
                                   Spearman_rho = cor_test$estimate, #
                                   p_value = cor_test$p.value))#
  # Tạo biểu đồ scatter + boxplot#
  ggplot(metadata, aes(x = Treatment_factor, y = .data[[metric]], fill = Treatment_factor)) +#
    geom_jitter(aes(color = Treatment_factor), width = 0.2, alpha = 0.7, size = 2) +  # Điểm dữ liệu#
    geom_boxplot(alpha = 0.5, outlier.shape = NA) +  # Boxplot trong suốt#
    scale_fill_manual(values = c("#1f77b4", "#ff7f0e")) +  # Màu xanh & cam#
    scale_color_manual(values = c("#1f77b4", "#ff7f0e")) +  # Màu xanh & cam cho điểm dữ liệu#
    labs(title = paste0(metric, "\n(p = ", signif(cor_test$p.value, 3), ")"),  # Xuống dòng cho p-value#
         x = "Treatment Group", y = metric) +#
    theme_minimal() +#
    theme(plot.title = element_text(size = 10),  # Giảm kích thước chữ tiêu đề#
          legend.position = "none")  # Ẩn legend#
})#
#
# Ghép tất cả biểu đồ thành một#
final_plot <- wrap_plots(plot_list) + #
  plot_annotation(title = "Correlation Between Treatment and Growth Metrics",#
                  theme = theme(plot.title = element_text(size = 14, face = "bold")))#
#
# Hiển thị biểu đồ#
print(final_plot)#
#
# Hiển thị bảng kết quả p-value#
print(cor_results)
# Load thư viện#
library(ggplot2)#
library(patchwork)#
#
# Chuyển Treatment thành factor để vẽ#
metadata$Treatment_factor <- as.factor(metadata$Treatment_binary)#
#
# Danh sách chỉ số sinh trưởng#
growth_metrics <- c("Final weight", "Specific growth rate", "Feed conversion ratio", #
                    "Weight gain", "Survival rate", "Percentage weight gain", "Daily weight gain")#
#
# Dataframe lưu kết quả p-value#
cor_results <- data.frame(Metric = character(), Spearman_rho = numeric(), p_value = numeric())#
#
# Tạo danh sách biểu đồ#
plot_list <- lapply(growth_metrics, function(metric) {#
  # Tính Spearman correlation#
  cor_test <- cor.test(metadata$Treatment_binary, metadata[[metric]], method = "spearman")#
  # Lưu kết quả vào dataframe#
  cor_results <<- rbind(cor_results, #
                        data.frame(Metric = metric, #
                                   Spearman_rho = cor_test$estimate, #
                                   p_value = cor_test$p.value))#
  # Tạo chuỗi p-value nhỏ hơn và in nghiêng#
  p_text <- paste0("italic(p) == ", signif(cor_test$p.value, 3))#
  # Tạo biểu đồ scatter + boxplot#
  ggplot(metadata, aes(x = Treatment_factor, y = .data[[metric]], fill = Treatment_factor)) +#
    geom_jitter(width = 0.2, alpha = 0.7, color = "black", size = 2) +  # Điểm dữ liệu#
    geom_boxplot(alpha = 0.4, outlier.shape = NA, color = "black", lwd = 0.5) +  # Boxplot viền mỏng hơn#
    scale_fill_manual(values = c("#377eb8", "#e41a1c")) +  # Màu xanh - đỏ chuyên nghiệp#
    labs(title = metric, x = "Treatment Group", y = metric) +#
    theme_minimal() +#
    theme(#
      plot.title = element_text(face = "bold", size = 14),  # Tiêu đề lớn hơn#
      axis.title = element_text(size = 12),  # Tiêu đề trục lớn#
      axis.text = element_text(size = 11),  # Chữ trục dễ đọc#
      legend.position = "none"  # Ẩn legend vì chỉ có 2 nhóm#
    ) +#
    annotate("text", x = 1.5, y = max(metadata[[metric]], na.rm = TRUE), #
             label = p_text, parse = TRUE, size = 4, hjust = 0.5)  # Thêm p-value in nghiêng#
})#
#
# Ghép tất cả biểu đồ thành một#
final_plot <- wrap_plots(plot_list) + #
  plot_annotation(title = "Correlation Between Treatment and Growth Metrics")#
#
# Hiển thị biểu đồ#
print(final_plot)#
#
# Hiển thị bảng kết quả p-value#
print(cor_results)
