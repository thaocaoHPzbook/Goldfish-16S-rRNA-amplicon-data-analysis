# Chọn biến metadata để so sánh (ví dụ "Final weight")#
target_variable <- "Final weight"#
#
# Hàm tính tương quan cho từng OTU#
compute_spearman <- function(otu_id) {#
  df <- merged_data %>%#
    filter(OTU_ID == otu_id) %>%#
    select(abundance, all_of(target_variable))#
  result <- cor.test(df$abundance, df[[target_variable]], method = "spearman")#
  return(tibble(OTU_ID = otu_id, Spearman_rho = result$estimate, p_value = result$p.value))#
}#
#
# Tính tương quan cho tất cả OTU#
otu_list <- unique(merged_data$OTU_ID)#
cor_results <- map_dfr(otu_list, compute_spearman)#
#
# Lưu kết quả ra file#
write_tsv(cor_results, "spearman_results.tsv")#
#
# In ra các OTU có tương quan đáng kể (p < 0.05)#
cor_results %>% filter(p_value < 0.05)
library(readr)#
library(dplyr)#
library(ggplot2)
metadata <- read_tsv("/Users/truonganhtu/Downloads/metadata.tsv")
head(metadata)
metadata <- metadata %>%#
  mutate(Treatment_binary = ifelse(Treatment == "Control", 0, 1))
head(metadata)
growth_metrics <- c("Final weight", "Specific growth rate", "Feed conversion ratio", #
                    "Weight gain", "Survival rate", "Percentage weight gain", "Daily weight gain")
cor_results <- data.frame(Metric = character(), Spearman_rho = numeric(), p_value = numeric())#
#
for (metric in growth_metrics) {#
  cor_test <- cor.test(metadata$Treatment_binary, metadata[[metric]], method = "spearman")#
  cor_results <- rbind(cor_results, #
                       data.frame(Metric = metric, #
                                  Spearman_rho = cor_test$estimate, #
                                  p_value = cor_test$p.value))#
}
print(cor_results)
library(ggplot2)#
#
# Chuyển Treatment_binary về dạng factor (nhóm)#
metadata$Treatment_binary <- as.factor(metadata$Treatment_binary)#
#
# Vẽ boxplot cho từng chỉ số sinh trưởng#
for (metric in growth_metrics) {#
  p <- ggplot(metadata, aes(x = Treatment_binary, y = .data[[metric]], fill = Treatment_binary)) +#
    geom_boxplot(alpha = 0.6) +#
    geom_jitter(width = 0.2, alpha = 0.6) +#
    labs(title = paste("Boxplot of", metric, "by Treatment"),#
         x = "Treatment (0 = Control, 1 = Treatment)",#
         y = metric) +#
    theme_minimal() +#
    scale_fill_manual(values = c("#E69F00", "#56B4E9"))  # Màu cho nhóm Control & Treatment#
  print(p)#
}
for (metric in growth_metrics) {#
  p <- ggplot(metadata, aes(x = Treatment_binary, y = .data[[metric]])) +#
    geom_point(color = "blue", size = 3, alpha = 0.6) +#
    geom_smooth(method = "lm", col = "red", se = FALSE) +#
    labs(title = paste("Scatterplot:", metric, "vs. Treatment"),#
         x = "Treatment (0 = Control, 1 = Treatment)",#
         y = metric) +#
    theme_minimal()#
  print(p)#
}
library(ggcorrplot)#
#
# Tính ma trận tương quan Spearman#
cor_matrix <- cor(metadata[, growth_metrics], method = "spearman", use = "pairwise.complete.obs")#
#
# Heatmap của hệ số tương quan#
ggcorrplot(cor_matrix, #
           method = "circle", #
           type = "lower", #
           lab = TRUE, #
           colors = c("red", "white", "blue"), #
           title = "Spearman Correlation Heatmap")
# Cài đặt nếu chưa có#
install.packages(c("ggplot2", "patchwork"))#
#
# Load thư viện#
library(ggplot2)#
library(patchwork)#
#
# Chuyển Treatment thành dạng factor để vẽ#
metadata$Treatment_factor <- as.factor(metadata$Treatment_binary)#
#
# Danh sách chỉ số cần vẽ#
growth_metrics <- c("Final weight", "Specific growth rate", "Feed conversion ratio", #
                    "Weight gain", "Survival rate", "Percentage weight gain", "Daily weight gain")#
#
# Hàm tạo scatter plot cho từng chỉ số#
plot_list <- lapply(growth_metrics, function(metric) {#
  ggplot(metadata, aes(x = Treatment_factor, y = .data[[metric]])) +#
    geom_jitter(width = 0.2, alpha = 0.7, color = "blue") +  # Điểm dữ liệu#
    geom_boxplot(alpha = 0.3, outlier.shape = NA) +  # Boxplot để thấy phân bố#
    labs(title = metric, x = "Treatment", y = metric) +#
    theme_minimal()#
})#
#
# Kết hợp tất cả các biểu đồ#
final_plot <- wrap_plots(plot_list) + plot_annotation(title = "Tương quan giữa Treatment và các chỉ số sinh trưởng")#
#
# Hiển thị biểu đồ#
print(final_plot)
# Cài đặt nếu chưa có#
install.packages(c("ggplot2", "patchwork"))#
#
# Load thư viện#
library(ggplot2)#
library(patchwork)#
#
# Chuyển Treatment thành dạng factor để vẽ#
metadata$Treatment_factor <- as.factor(metadata$Treatment_binary)#
#
# Danh sách chỉ số sinh trưởng#
growth_metrics <- c("Final weight", "Specific growth rate", "Feed conversion ratio", #
                    "Weight gain", "Survival rate", "Percentage weight gain", "Daily weight gain")#
#
# Dataframe lưu kết quả p-value#
cor_results <- data.frame(Metric = character(), Spearman_rho = numeric(), p_value = numeric())#
#
# Tạo danh sách biểu đồ#
plot_list <- lapply(growth_metrics, function(metric) {#
  # Tính Spearman correlation#
  cor_test <- cor.test(metadata$Treatment_binary, metadata[[metric]], method = "spearman")#
  # Lưu kết quả vào dataframe#
  cor_results <<- rbind(cor_results, #
                        data.frame(Metric = metric, #
                                   Spearman_rho = cor_test$estimate, #
                                   p_value = cor_test$p.value))#
  # Tạo biểu đồ scatter + boxplot#
  ggplot(metadata, aes(x = Treatment_factor, y = .data[[metric]])) +#
    geom_jitter(width = 0.2, alpha = 0.7, color = "blue") +  # Điểm dữ liệu#
    geom_boxplot(alpha = 0.3, outlier.shape = NA) +  # Boxplot#
    labs(title = paste0(metric, " (p = ", signif(cor_test$p.value, 3), ")"),#
         x = "Treatment Group", y = metric) +#
    theme_minimal()#
})#
#
# Ghép tất cả biểu đồ thành một#
final_plot <- wrap_plots(plot_list) + #
  plot_annotation(title = "Correlation Between Treatment and Growth Metrics")#
#
# Hiển thị biểu đồ#
print(final_plot)#
#
# Hiển thị bảng kết quả p-value#
print(cor_results)
