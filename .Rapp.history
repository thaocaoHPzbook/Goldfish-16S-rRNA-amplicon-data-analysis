p <- ggpairs(df_corr,#
             lower = list(continuous = wrap("cor", method = "spearman", size = 5, color = "blue")),#
             upper = list(continuous = wrap("points", alpha = 0.6, color = "#2C3E50")),#
             diag = list(continuous = wrap("densityDiag", fill = "#3498DB", color = "black"))#
) +#
