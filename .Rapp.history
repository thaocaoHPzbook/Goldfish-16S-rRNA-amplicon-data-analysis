# Thiết lập tham số#
size <- 190#
x_obs <- 125#
p_values <- seq(0.50, 0.80, by = 0.01)  # Dãy p từ 0.50 đến 0.80#
likelihood <- numeric(length(p_values))  # Mảng lưu giá trị likelihood#
#
# Tính xác suất với vòng lặp for#
for (i in 1:length(p_values)) {#
  likelihood[i] <- dbinom(x_obs, size, p_values[i])#
}#
#
# Vẽ đồ thị likelihood#
plot(p_values, likelihood, type = "l", lwd = 2, col = "black",#
     xlab = "p", ylab = "P(X = 125 | Binomial(190, p))",#
     main = "Likelihood function for X = 125")
pval <- seq(0.50, 0.80, by = 0.01)  #
likeli <- numeric(length(pval))#
#
for (i in 1:length(pval)) {#
  likeli[i] <- dbinom(125, 190, pval[i])#
}#
#
plot(pval, likeli, type = "l", lwd = 2, col = "black",#
     xlab = "p", ylab = "P(X = 125 | Binomial(190, p))")
