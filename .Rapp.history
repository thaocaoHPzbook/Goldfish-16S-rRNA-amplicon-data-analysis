#
print(p)
p <- ggpairs(df_corr,#
             lower = list(continuous = wrap("cor", method = "spearman", size = 4, color = "blue")),#
             upper = list(continuous = wrap("smooth", method = "lm", color = "red", alpha = 0.7)),#
             diag = list(continuous = wrap("densityDiag", fill = "#3498DB", color = "black"))#
) +#
  theme_minimal() +#
  theme(text = element_text(size = 10)) +  # Giảm cỡ chữ toàn bộ#
  ggtitle("Pairwise Spearman Correlation Matrix of Rose Petal and Growth Indicators")#
#
print(p)
