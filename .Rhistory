labs(title = "Boxplot of Shannon Alpha Diversity",
x = "",
y = "Shannon Entropy") +
theme_minimal()
data$Group <- ifelse(grepl("T1", data$Sample_ID), "T1",
ifelse(grepl("T0", data$Sample_ID), "T0", NA))
ggplot(data, aes(x = Group, y = Shannon_entropy, fill = Group)) +
geom_boxplot() +
labs(title = "Boxplot of Shannon Alpha Diversity by Group",
x = "Group",
y = "Shannon Entropy") +
theme_minimal() +
scale_fill_manual(values = c("T1" = "lightblue", "T0" = "lightgreen"))
ggplot(data, aes(x = Group, y = Shannon_entropy, fill = Group)) +
geom_boxplot() +
labs(title = "Boxplot of Shannon Alpha Diversity by Group",
x = "",
y = "Shannon diversity") +
theme_minimal() +
scale_fill_manual(values = c("T1" = "lightblue", "T0" = "lightgreen"))
data$Group <- ifelse(grepl("T1", data$Sample_ID), "Days 4-7",
ifelse(grepl("T0", data$Sample_ID), "Days 1-3", NA))
library(ggpubr)
# Vẽ boxplot với ggpubr và hiển thị p-value
ggboxplot(data, x = "Group", y = "Shannon_entropy",
fill = "Group", palette = c("lightgreen", "lightblue"),
ylab = "Shannon diversity", xlab = "Group") +
stat_compare_means(method = "t.test", label = "p.format") + # Hiển thị p-value từ t-test
labs(title = "Boxplot of Shannon Alpha Diversity by Group",
x = "Group",
y = "Shannon diversity") +
theme_minimal()
# Đặt thứ tự cho các nhóm
data$Group <- factor(data$Group, levels = c("Days 1-3", "Days 4-7"))
# Vẽ boxplot với ggpubr và hiển thị p-value
ggboxplot(data, x = "Group", y = "Shannon_entropy",
fill = "Group", palette = c("lightgreen", "lightblue"),
ylab = "Shannon diversity", xlab = "Group") +
stat_compare_means(method = "t.test", label = "p.format") + # Hiển thị p-value từ t-test
labs(title = "Boxplot of Shannon Alpha Diversity by Group",
x = "Group",
y = "Shannon diversity") +
theme_minimal()
