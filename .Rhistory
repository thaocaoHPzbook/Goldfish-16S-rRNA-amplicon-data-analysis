# Tạo danh sách các Sample_ID thuộc nhóm LRE
LRE_samples <- c("inf131Cat1T1n1", "inf131Cat1T0n1", "inf130Cat1T1n4", "inf184Cat1T1n1",
"inf147Cat1T1n4", "inf147Cat1T1n3", "inf147Cat1T1n2", "inf147Cat1T1n1",
"inf146Cat1T1n2", "inf146Cat1T1n1", "inf145Cat1T1n1", "inf130Cat1T1n3",
"inf130Cat1T1n2", "inf130Cat1T1n1", "inf130Cat1T0n2", "inf130Cat1T0n1",
"inf129Cat1T1n3", "inf129Cat1T1n2", "inf129Cat1T1n1", "inf183Cat1T1n1",
"inf183Cat1T0n1", "inf157Cat1T1n2", "inf157Cat1T1n1", "inf125Cat1T1n2",
"inf125Cat1T1n1", "inf138Cat1T1n1", "inf125Cat1T0n3", "inf138Cat1T0n1",
"inf137Cat1T1n1", "inf125Cat1T0n2", "inf124Cat1T1n2", "inf124Cat1T1n1",
"inf136Cat1T1n3", "inf136Cat1T1n2", "inf136Cat1T1n1", "inf136Cat1T0n2",
"inf136Cat1T0n1", "inf125Cat1T0n1", "inf134Cat1T1n2", "inf134Cat1T1n1",
"inf134Cat1T0n1", "inf127Cat1T1n1", "inf127Cat1T0n1")
# Gắn nhãn "LRE" và "non-LRE" cho các mẫu
data$LRE_status <- ifelse(data$Sample_ID %in% LRE_samples, "LRE", "non-LRE")
# Đặt thứ tự cho các nhóm "Days 1-3" và "Days 4-7"
data$Group <- factor(data$Group, levels = c("Days 1-3", "Days 4-7"))
# Vẽ boxplot và hiện thị p-value với phân chia LRE và non-LRE
ggboxplot(data, x = "Group", y = "Shannon_entropy",
color = "LRE_status", palette = c("lightcoral", "darkcyan"),
add = "jitter", fill = "LRE_status",
ylab = "Shannon diversity", xlab = "Group") +
stat_compare_means(aes(group = LRE_status), method = "t.test", label = "p.format") +
labs(title = "Shannon Alpha Diversity by Group and LRE Status",
x = "Group",
y = "Shannon diversity") +
theme_minimal()
# Đặt thứ tự cho các nhóm "Days 1-3" và "Days 4-7"
data$Group <- factor(data$Group, levels = c("Days 1-3", "Days 4-7"))
# Vẽ boxplot và hiển thị p-value với phân chia LRE và non-LRE
ggboxplot(data, x = "Group", y = "Shannon_entropy",
color = "LRE_status", palette = c("lightcoral", "darkcyan"),
add = "jitter", fill = "LRE_status",
ylab = "Shannon diversity", xlab = "Group") +
stat_compare_means(aes(group = LRE_status), method = "t.test",
label = "p.signif",
label.y = 1.1,
label.x.npc = "center",
hide.ns = TRUE) +
labs(title = "Shannon Alpha Diversity by Group and LRE Status",
x = "Group",
y = "Shannon diversity") +
theme_minimal()
# Đặt thứ tự cho các nhóm "Days 1-3" và "Days 4-7"
data$Group <- factor(data$Group, levels = c("Days 1-3", "Days 4-7"))
# Vẽ boxplot và hiển thị p-value với phân chia LRE và non-LRE
ggboxplot(data, x = "Group", y = "Shannon_entropy",
color = "LRE_status", palette = c("lightcoral", "darkcyan"),
add = "jitter", fill = "LRE_status",
ylab = "Shannon diversity", xlab = "Group") +
stat_compare_means(aes(group = LRE_status), method = "t.test",
label = "p.format",
label.y = 1.1,
label.x.npc = "center",
hide.ns = TRUE) +
labs(title = "Shannon Alpha Diversity by Group and LRE Status",
x = "Group",
y = "Shannon diversity") +
theme_minimal()
# Đặt thứ tự cho các nhóm "Days 1-3" và "Days 4-7"
data$Group <- factor(data$Group, levels = c("Days 1-3", "Days 4-7"))
# Hàm để tùy chỉnh hiển thị p-value
custom_label <- function(p) {
if (p < 0.05) {
return(format(p, digits = 2))
} else {
return("")
}
}
# Vẽ boxplot và hiện thị p-value với phân chia LRE và non-LRE
ggboxplot(data, x = "Group", y = "Shannon_entropy",
color = "LRE_status", palette = c("lightcoral", "darkcyan"),
add = "jitter", fill = "LRE_status",
ylab = "Shannon diversity", xlab = "Group") +
stat_compare_means(aes(group = LRE_status), method = "t.test",
label = "p.signif",
label.x.npc = "middle",
label.y.npc = "top",
label.format = custom_label(..p..)) +
labs(title = "Shannon Alpha Diversity by Group and LRE Status",
x = "Group",
y = "Shannon diversity") +
theme_minimal()
# Gắn nhãn "LRE" và "non-LRE" cho các mẫu
data$LRE_status <- ifelse(data$Sample_ID %in% LRE_samples, "LRE", "non-LRE")
# Đặt thứ tự cho các nhóm "Days 1-3" và "Days 4-7"
data$Group <- factor(data$Group, levels = c("Days 1-3", "Days 4-7"))
# Vẽ boxplot và hiện thị p-value với phân chia LRE và non-LRE
ggboxplot(data, x = "Group", y = "Shannon_entropy",
color = "LRE_status", palette = c("lightcoral", "darkcyan"),
add = "jitter", fill = "LRE_status",
ylab = "Shannon diversity", xlab = "Group") +
stat_compare_means(aes(group = LRE_status), method = "t.test", label = "p.format") +
labs(title = "Shannon Alpha Diversity by Group and LRE Status",
x = "Group",
y = "Shannon diversity") +
theme_minimal()
